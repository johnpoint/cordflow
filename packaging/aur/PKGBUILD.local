# Local workspace package assembled by scripts/build-arch-package.sh.

pkgname=cordflow
pkgver=0.1.0
pkgrel=2
pkgdesc='PipeWire audio router and output mixer'
arch=('x86_64')
url='https://github.com/johnpoint/cordflow'
license=('GPL-3.0-only')
depends=(
  'cairo'
  'dbus'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libayatana-appindicator'
  'libgcc'
  'libpipewire'
  'libsoup3'
  'pipewire'
  'webkit2gtk-4.1'
)
optdepends=('wireplumber: default input and output device management')
options=('!debug')
source=(
  'cordflow'
  'cordflow.desktop'
  'icon.png'
  'io.github.johnpoint.Cordflow.metainfo.xml'
  'LICENSE'
)
sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
)

package() {
  install -Dm755 \
    "$srcdir/cordflow" \
    "$pkgdir/usr/bin/cordflow"
  install -Dm644 \
    "$srcdir/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/cordflow.png"
  install -Dm644 \
    "$srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 \
    "$srcdir/cordflow.desktop" \
    "$pkgdir/usr/share/applications/cordflow.desktop"
  install -Dm644 \
    "$srcdir/io.github.johnpoint.Cordflow.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/io.github.johnpoint.Cordflow.metainfo.xml"
}
