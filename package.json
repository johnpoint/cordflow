{
  "name": "cordflow",
  "version": "0.1.0",
  "private": true,
  "description": "An accessible PipeWire audio router and output mixer built with Tauri and Svelte.",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "start": "bash scripts/start.sh",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "security:check": "node scripts/check-security.mjs",
    "tauri": "tauri",
    "build:tauri": "tauri build --no-bundle",
    "build:deb": "tauri build --bundles deb --ci",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pipewire-live": "bash scripts/live-pipewire-smoke.sh",
    "types:generate": "cargo run --manifest-path src-tauri/Cargo.toml --quiet --features type-export --bin export-types > src/lib/generated/graph.ts",
    "types:check": "cargo test --manifest-path src-tauri/Cargo.toml typescript_contract_is_current"
  },
  "dependencies": {
    "@lucide/svelte": "^1.25.0",
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.50.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "^22.20.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-svelte": "3.20.0",
    "globals": "^16.5.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.6",
    "svelte-check": "4.7.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.64.0",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  }
}
